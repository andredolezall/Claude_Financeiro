# Copie para .env e preencha. NUNCA versione o .env (já está no .gitignore).

# Token da integração interna do Notion (notion.so/my-integrations).
# Necessário apenas para os comandos de sincronização com o Notion.
NOTION_TOKEN=

# IDs dos databases do Notion (ver docs/06-notion-estrutura.md).
NOTION_DB_DEPARTAMENTOS=
NOTION_DB_PILARES=
NOTION_DB_PROCESSOS=
NOTION_DB_MICROPROCESSOS=

# ─────────────────────────────────────────────────────────────────────────────
# PLATAFORMA DGR (consultoria + automação financeira via WhatsApp / DG consultor)
# ─────────────────────────────────────────────────────────────────────────────

# Claude API (Anthropic). Sem esta chave, a plataforma roda em modo MOCK determinístico.
ANTHROPIC_API_KEY=
# IDs de modelo por tarefa (controle de COGS). Defaults definidos em src/dg/anthropic.ts.
DGR_MODEL_EXTRACTION=claude-haiku-4-5-20251001
DGR_MODEL_CONSULTANT=claude-opus-4-8

# WhatsApp Cloud API (Meta). Sem estes valores, o webhook responde 503 (mas a demo roda).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Governança do aprendizado anonimizado entre tenants (§5.4): nº mínimo de empresas
# distintas para publicar um padrão (anti-reidentificação).
DGR_LEARNING_MIN_TENANTS=5

# Porta do servidor MVP.
PORT=3000
