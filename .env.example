# Copie para .env e preencha. NUNCA versione o .env (já está no .gitignore).

# Token da integração interna do Notion (notion.so/my-integrations).
# Necessário apenas para os comandos de sincronização com o Notion.
NOTION_TOKEN=

# IDs dos databases do Notion (ver docs/06-notion-estrutura.md).
NOTION_DB_DEPARTAMENTOS=
NOTION_DB_PILARES=
NOTION_DB_PROCESSOS=
NOTION_DB_MICROPROCESSOS=
