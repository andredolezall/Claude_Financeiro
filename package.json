{
  "name": "dgr-plataforma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma DGR Gestão em Resultado — consultoria B2B + automação financeira via WhatsApp (DG consultor de IA).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "test": "npm run build && node --test dist/test/platform/*.test.js",
    "demo": "npm run build && node dist/src/demo/run.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
